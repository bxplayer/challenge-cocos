# App
SERVER_PORT=8080

# PostgreSQL (usado por docker-compose y por la app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocos
DB_USER=cocos
DB_PASSWORD=cocos

# Redis (idempotencia + cache-aside del portfolio)
REDIS_HOST=localhost
REDIS_PORT=6379
PORTFOLIO_CACHE_TTL_SECONDS=60
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_KEY_TTL_SECONDS=86400
